rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isCurrentUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isReviewer() {
      return isSignedIn() && (
        isAdmin() ||
        exists(/databases/$(database)/documents/reviewers/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'reviewer')
      );
    }

    function hasRotatedProofs() {
      return exists(/databases/$(database)/documents/private_security/staff_proofs) &&
        get(/databases/$(database)/documents/private_security/staff_proofs).data.get('overrideActive', false) == true;
    }

    function isAdminProofHex(proofHex) {
      return hasRotatedProofs()
        ? (
            proofHex == get(/databases/$(database)/documents/private_security/staff_proofs).data.get('adminCredProofHash', '') ||
            proofHex == get(/databases/$(database)/documents/private_security/staff_proofs).data.get('adminPinProofHash', '')
          )
        : (
            proofHex == '37b5e2fb13fd22e68ebb7b4758b818fdcc00eda39d24ebf3adfdba909fd95939' ||
            proofHex == '1606a2cb998df5af2c3ca1393931fadd841ffe852f4f75eaae2c1f74643e4923'
          );
    }

    function isReviewerProofHex(proofHex) {
      return hasRotatedProofs()
        ? (
            proofHex == get(/databases/$(database)/documents/private_security/staff_proofs).data.get('revCredProofHash', '') ||
            proofHex == get(/databases/$(database)/documents/private_security/staff_proofs).data.get('revPinProofHash', '')
          )
        : (
            proofHex == 'a4dac78e849c5b67640ee8b011a8c55bbec1e8f130169b9dd4600f5172fe2680' ||
            proofHex == 'e0b47a82d8ebe6eb4bcb9f28d250542fc4bff3df17716cc3beca5b6a817c6237'
          );
    }

    function isValidOpProofData(data, minRole) {
      let proof = data.get('authProof', '');
      let proofHex = hashing.sha256(('TP_PROOF_V3:' + proof).toUtf8()).toHexString().lower();
      let opRole = data.get('role', '');
      return proof is string && proof.size() >= 32 && proof.size() <= 128 &&
        data.get('opTime', null) == request.time &&
        (
          minRole == 'admin'
            ? (opRole == 'admin' && isAdminProofHex(proofHex))
            : (
                (opRole == 'admin' && isAdminProofHex(proofHex)) ||
                (opRole == 'reviewer' && isReviewerProofHex(proofHex))
              )
        );
    }

    function hasValidStaffOp(colName, docId, minRole) {
      let opPath = /databases/$(database)/documents/staff_ops/$(colName + '__' + docId);
      return existsAfter(opPath) && isValidOpProofData(getAfter(opPath).data, minRole);
    }

    function validAdminProof() {
      let proof = incoming().get('authProof', '');
      let proofHex = hashing.sha256(('TP_PROOF_V3:' + proof).toUtf8()).toHexString().lower();
      return proof is string && proof.size() >= 32 && proof.size() <= 128 && isAdminProofHex(proofHex);
    }

    function validReviewerProof() {
      let proof = incoming().get('authProof', '');
      let proofHex = hashing.sha256(('TP_PROOF_V3:' + proof).toUtf8()).toHexString().lower();
      return proof is string && proof.size() >= 32 && proof.size() <= 128 && isReviewerProofHex(proofHex);
    }

    // Secret proof digests (never readable by clients)
    match /private_security/{docId} {
      allow read: if false;
      allow create, update: if isValidId(docId) && (
        isAdmin() || hasValidStaffOp('private_security', docId, 'admin')
      );
      allow delete: if false;
    }

    // Salted verification hashes for login matching (never listable)
    match /staff_security/{docId} {
      allow get: if isValidId(docId);
      allow list: if false;
      allow create, update: if isValidId(docId) && (
        isAdmin() || hasValidStaffOp('staff_security', docId, 'admin')
      );
      allow delete: if false;
    }

    // Ephemeral atomic batch proof verifier (never readable by clients)
    match /staff_ops/{opId} {
      allow read: if false;
      allow create, update: if isValidId(opId) && isValidOpProofData(incoming(), incoming().get('role', ''));
      allow delete: if false;
    }

    // Admin & Reviewer role marker docs
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isCurrentUser(userId) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(userId) && (
        isAdmin() ||
        hasValidStaffOp('admins', userId, 'admin') ||
        (isCurrentUser(userId) && validAdminProof())
      );
      allow delete: if isValidId(userId) && (
        isAdmin() || hasValidStaffOp('admins', userId, 'admin')
      );
    }

    match /reviewers/{userId} {
      allow get: if isValidId(userId) && (isCurrentUser(userId) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(userId) && (
        isAdmin() ||
        hasValidStaffOp('reviewers', userId, 'admin') ||
        (isCurrentUser(userId) && validReviewerProof())
      );
      allow delete: if isValidId(userId) && (
        isAdmin() || hasValidStaffOp('reviewers', userId, 'admin')
      );
    }

    // Users Collection (PII-free school profiles)
    match /users/{userId} {
      allow read: if true;

      allow create: if isValidId(userId) && (
        isAdmin() ||
        hasValidStaffOp('users', userId, 'admin') ||
        (
          incoming().uid == userId &&
          incoming().role == 'reviewer' &&
          hasValidStaffOp('users', userId, 'reviewer')
        ) ||
        (
          (isCurrentUser(userId) || userId.matches('^stu_[a-zA-Z0-9_\\-]+$')) &&
          incoming().uid == userId &&
          incoming().role == 'student' &&
          incoming().balance == 0 &&
          incoming().totalEarned == 0 &&
          incoming().totalPieces == 0 &&
          incoming().get('disabled', false) == false
        )
      );

      allow update: if isValidId(userId) && (
        isAdmin() ||
        hasValidStaffOp('users', userId, 'admin') ||
        (
          (isReviewer() || hasValidStaffOp('users', userId, 'reviewer')) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'balance', 'totalEarned', 'totalPieces', 'certificateEarned', 'updatedAt'
          ])
        ) ||
        (
          (isCurrentUser(userId) || (userId.matches('^stu_[a-zA-Z0-9_\\-]+$') && existing().role == 'student')) &&
          incoming().get('disabled', false) == existing().get('disabled', false) &&
          incoming().role == existing().role &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'className', 'number', 'studentId', 'avatar', 'profileCompleted', 'updatedAt'
            ]) ||
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['balance']) &&
              incoming().balance >= 0 &&
              incoming().balance < existing().balance
            ) ||
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'totalEarned']) &&
              incoming().balance > existing().balance &&
              incoming().balance <= existing().balance + 20 &&
              incoming().totalEarned > existing().totalEarned &&
              incoming().totalEarned <= existing().totalEarned + 20
            )
          )
        )
      );

      allow delete: if isValidId(userId) && (isAdmin() || hasValidStaffOp('users', userId, 'admin'));
    }

    // Locations Collection
    match /locations/{locationId} {
      allow read: if true;
      allow create, update, delete: if isValidId(locationId) && (
        isAdmin() || hasValidStaffOp('locations', locationId, 'admin')
      );
    }

    // Submissions Collection
    match /submissions/{submissionId} {
      allow read: if true;
      allow create: if isValidId(submissionId) &&
        incoming().status == 'pending' &&
        incoming().points == 0 &&
        (
          (isSignedIn() && incoming().userId == request.auth.uid) ||
          incoming().userId.matches('^(stu|staff)_[a-zA-Z0-9_\\-]+$')
        );
      allow update: if isValidId(submissionId) && (
        isReviewer() || hasValidStaffOp('submissions', submissionId, 'reviewer')
      );
      allow delete: if isValidId(submissionId) && (
        isAdmin() || hasValidStaffOp('submissions', submissionId, 'admin')
      );
    }

    // Rewards Collection
    match /rewards/{rewardId} {
      allow read: if true;
      allow create, delete: if isValidId(rewardId) && (
        isAdmin() || hasValidStaffOp('rewards', rewardId, 'admin')
      );
      allow update: if isValidId(rewardId) && (
        isAdmin() ||
        hasValidStaffOp('rewards', rewardId, 'admin') ||
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['stock']) &&
          incoming().stock >= 0 &&
          incoming().stock == existing().stock - 1
        )
      );
    }

    // Redemptions Collection
    match /redemptions/{redemptionId} {
      allow read: if true;
      allow create: if isValidId(redemptionId) &&
        incoming().status == 'pending' &&
        incoming().cost > 0 &&
        (
          (isSignedIn() && incoming().userId == request.auth.uid) ||
          incoming().userId.matches('^(stu|staff)_[a-zA-Z0-9_\\-]+$')
        );
      allow update: if isValidId(redemptionId) && (
        isReviewer() || hasValidStaffOp('redemptions', redemptionId, 'reviewer')
      );
      allow delete: if isValidId(redemptionId) && (
        isAdmin() || hasValidStaffOp('redemptions', redemptionId, 'admin')
      );
    }

    // Missions Collection
    match /missions/{missionId} {
      allow read: if true;
      allow create, update, delete: if isValidId(missionId) && (
        isAdmin() || hasValidStaffOp('missions', missionId, 'admin')
      );
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if true;
      allow create: if isValidId(notificationId) && (
        isReviewer() || hasValidStaffOp('notifications', notificationId, 'reviewer')
      );
      allow update: if isValidId(notificationId) && (
        isReviewer() ||
        hasValidStaffOp('notifications', notificationId, 'reviewer') ||
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['read']) &&
          incoming().read == true
        )
      );
      allow delete: if isValidId(notificationId) && (
        isAdmin() || hasValidStaffOp('notifications', notificationId, 'admin')
      );
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isValidId(settingId) && (
        isAdmin() || hasValidStaffOp('settings', settingId, 'admin')
      );
    }
  }
}
