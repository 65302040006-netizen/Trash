rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isCurrentUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == '65302040006@svc.ac.th' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isReviewer() {
      return isSignedIn() && (
        isAdmin() ||
        exists(/databases/$(database)/documents/reviewers/$(request.auth.uid))
      );
    }

    // Admins and Reviewers role collections
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /reviewers/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isCurrentUser(userId) &&
        request.resource.data.uid == userId &&
        (request.resource.data.role == 'student' || isAdmin()) &&
        request.resource.data.totalEarned == 0 &&
        request.resource.data.balance == 0;
      allow update: if isAdmin() || isReviewer() || (
        isCurrentUser(userId) &&
        // Prevent users from escalating role or giving themselves points
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'totalEarned', 'balance', 'totalPieces', 'disabled'])
      );
      allow delete: if isAdmin();
    }

    // Locations Collection
    match /locations/{locationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Submissions Collection
    match /submissions/{submissionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.points == 0;
      allow update: if isReviewer() || isAdmin();
      allow delete: if isAdmin();
    }

    // Rewards Collection
    match /rewards/{rewardId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
      );
    }

    // Redemptions Collection
    match /redemptions/{redemptionId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isReviewer() || isAdmin()
      );
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if isReviewer() || isAdmin();
      allow delete: if isAdmin();
    }

    // Missions Collection
    match /missions/{missionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || resource.data.userId == 'all'
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
