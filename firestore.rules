rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isCurrentUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isReviewer() {
      return isSignedIn() && (
        isAdmin() ||
        exists(/databases/$(database)/documents/reviewers/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'reviewer')
      );
    }

    function hasRotatedProofs() {
      return exists(/databases/$(database)/documents/private_security/staff_proofs) &&
        get(/databases/$(database)/documents/private_security/staff_proofs).data.get('overrideActive', false) == true;
    }

    function validAdminProof() {
      let proof = incoming().get('authProof', '');
      let proofHex = hashing.sha256(('TP_PROOF_V3:' + proof).toUtf8()).toHexString().lower();
      return proof is string && proof.size() >= 32 && proof.size() <= 128 && (
        hasRotatedProofs()
          ? (
              proofHex == get(/databases/$(database)/documents/private_security/staff_proofs).data.get('adminCredProofHash', '') ||
              proofHex == get(/databases/$(database)/documents/private_security/staff_proofs).data.get('adminPinProofHash', '')
            )
          : (
              proofHex == '37b5e2fb13fd22e68ebb7b4758b818fdcc00eda39d24ebf3adfdba909fd95939' ||
              proofHex == '1606a2cb998df5af2c3ca1393931fadd841ffe852f4f75eaae2c1f74643e4923'
            )
      );
    }

    function validReviewerProof() {
      let proof = incoming().get('authProof', '');
      let proofHex = hashing.sha256(('TP_PROOF_V3:' + proof).toUtf8()).toHexString().lower();
      return proof is string && proof.size() >= 32 && proof.size() <= 128 && (
        hasRotatedProofs()
          ? (
              proofHex == get(/databases/$(database)/documents/private_security/staff_proofs).data.get('revCredProofHash', '') ||
              proofHex == get(/databases/$(database)/documents/private_security/staff_proofs).data.get('revPinProofHash', '')
            )
          : (
              proofHex == 'a4dac78e849c5b67640ee8b011a8c55bbec1e8f130169b9dd4600f5172fe2680' ||
              proofHex == 'e0b47a82d8ebe6eb4bcb9f28d250542fc4bff3df17716cc3beca5b6a817c6237'
            )
      );
    }

    // Server-side/Admin-only secret proof digests (unreadable by any client)
    match /private_security/{docId} {
      allow read: if false;
      allow write: if isValidId(docId) && isAdmin();
    }

    // Publicly gettable salted verification hashes (lists disabled, writes Admin-only)
    match /staff_security/{docId} {
      allow get: if isValidId(docId);
      allow list: if false;
      allow write: if isValidId(docId) && isAdmin();
    }

    // Admin role elevation protected by double-hashed cryptographic proof
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isCurrentUser(userId) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(userId) && (
        isAdmin() ||
        (isCurrentUser(userId) && validAdminProof())
      );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Reviewer role elevation protected by double-hashed cryptographic proof
    match /reviewers/{userId} {
      allow get: if isValidId(userId) && (isCurrentUser(userId) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(userId) && (
        isAdmin() ||
        (isCurrentUser(userId) && validReviewerProof())
      );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Users Collection: students cannot escalate roles or inflate points beyond mission claims
    match /users/{userId} {
      allow get: if isValidId(userId) && (isCurrentUser(userId) || isSignedIn());
      allow list: if isSignedIn();

      allow create: if isValidId(userId) && isCurrentUser(userId) && (
        isAdmin() ||
        (
          incoming().uid == userId &&
          incoming().role == 'student' &&
          incoming().balance == 0 &&
          incoming().totalEarned == 0 &&
          incoming().totalPieces == 0 &&
          incoming().get('disabled', false) == false
        ) ||
        (
          incoming().uid == userId &&
          incoming().role == 'admin' &&
          exists(/databases/$(database)/documents/admins/$(userId))
        ) ||
        (
          incoming().uid == userId &&
          incoming().role == 'reviewer' &&
          exists(/databases/$(database)/documents/reviewers/$(userId))
        )
      );

      allow update: if isValidId(userId) && (
        isAdmin() ||
        (
          isReviewer() &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'balance', 'totalEarned', 'totalPieces', 'certificateEarned', 'updatedAt'
          ])
        ) ||
        (
          isCurrentUser(userId) &&
          incoming().get('disabled', false) == existing().get('disabled', false) &&
          (
            // Authorized staff role sync only when membership doc already exists
            (
              incoming().role == 'admin' &&
              exists(/databases/$(database)/documents/admins/$(userId))
            ) ||
            (
              incoming().role == 'reviewer' &&
              exists(/databases/$(database)/documents/reviewers/$(userId))
            ) ||
            (
              incoming().role == existing().role &&
              (
                // Profile details update (cannot touch balance/totalEarned/role/disabled)
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'name', 'className', 'number', 'studentId', 'avatar', 'profileCompleted', 'updatedAt'
                ]) ||
                // Reward redemption balance deduction
                (
                  incoming().diff(existing()).affectedKeys().hasOnly(['balance']) &&
                  incoming().balance >= 0 &&
                  incoming().balance < existing().balance
                ) ||
                // Daily mission bonus claim (strictly bounded per claim)
                (
                  incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'totalEarned']) &&
                  incoming().balance > existing().balance &&
                  incoming().balance <= existing().balance + 20 &&
                  incoming().totalEarned > existing().totalEarned &&
                  incoming().totalEarned <= existing().totalEarned + 20
                )
              )
            )
          )
        )
      );

      allow delete: if isValidId(userId) && isAdmin();
    }

    // Locations Collection
    match /locations/{locationId} {
      allow read: if isSignedIn();
      allow write: if isValidId(locationId) && isAdmin();
    }

    // Submissions Collection
    match /submissions/{submissionId} {
      allow get: if isValidId(submissionId) && isSignedIn() && (
        existing().userId == request.auth.uid || isReviewer()
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isReviewer()
      );
      allow create: if isValidId(submissionId) && isSignedIn() &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().points == 0;
      allow update: if isValidId(submissionId) && isReviewer();
      allow delete: if isValidId(submissionId) && isAdmin();
    }

    // Rewards Collection
    match /rewards/{rewardId} {
      allow read: if isSignedIn();
      allow create, delete: if isValidId(rewardId) && isAdmin();
      allow update: if isValidId(rewardId) && (
        isAdmin() ||
        (
          isSignedIn() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['stock']) &&
          incoming().stock >= 0 &&
          incoming().stock == existing().stock - 1
        )
      );
    }

    // Redemptions Collection
    match /redemptions/{redemptionId} {
      allow get: if isValidId(redemptionId) && isSignedIn() && (
        existing().userId == request.auth.uid || isReviewer()
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isReviewer()
      );
      allow create: if isValidId(redemptionId) && isSignedIn() &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().cost > 0;
      allow update: if isValidId(redemptionId) && isReviewer();
      allow delete: if isValidId(redemptionId) && isAdmin();
    }

    // Missions Collection
    match /missions/{missionId} {
      allow read: if isSignedIn();
      allow write: if isValidId(missionId) && isAdmin();
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSignedIn() && (
        existing().userId == request.auth.uid ||
        existing().userId == 'all' ||
        isReviewer()
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId == 'all' ||
        isReviewer()
      );
      allow create: if isValidId(notificationId) && isReviewer();
      allow update: if isValidId(notificationId) && isSignedIn() && (
        isReviewer() ||
        (
          existing().userId == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['read'])
        )
      );
      allow delete: if isValidId(notificationId) && isAdmin();
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isValidId(settingId) && isAdmin();
    }
  }
}
